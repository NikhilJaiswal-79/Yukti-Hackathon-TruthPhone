# Copy to aws\.env for local development (aws\.env is gitignored).
# SESSION_TABLE is the DynamoDB table created by infra/backend.yaml. It gets a
# CloudFormation-generated name, so read the real value from the stack output:
#   aws cloudformation describe-stacks --stack-name truthphone --region ap-south-1 \
#     --query "Stacks[0].Outputs[?OutputKey=='SessionTableName'].OutputValue" --output text
AWS_REGION=ap-south-1
# Cheap model for chat / clarification.
BEDROCK_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0
# Strong model for claim extraction, judging and the final report.
# Sonnet 5.x needs Bedrock model access first; 4.6 works today.
VERIFY_MODEL_ID=global.anthropic.claude-sonnet-4-6
SESSION_TABLE=truthphone-sessions
WORKER_FUNCTION_NAME=truthphone-worker
LOCAL_WORKER=1
MAX_PHONES=2
MAX_CLAIMS=12
BROWSER_SESSION_TIMEOUT=600
SESSION_TTL_SECONDS=86400
ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
